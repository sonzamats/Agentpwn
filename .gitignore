.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ----- Linting -----
.ruff_cache/

# ----- Distribution / Packaging -----
*.tar.gz
*.zip
MANIFEST

# ----- Jupyter Notebooks -----
.ipynb_checkpoints/

